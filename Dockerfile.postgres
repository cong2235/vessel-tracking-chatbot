# PostgreSQL + PostGIS + pgvector trong cùng một image, vì đề bài cần cả
# truy vấn không gian (vị trí tàu) lẫn vector database (bộ nhớ dài hạn) trên
# cùng một cơ sở dữ liệu để giảm độ phức tạp hạ tầng.
FROM postgis/postgis:16-3.4

RUN apt-get update \
    && apt-get install -y --no-install-recommends postgresql-16-pgvector \
    && rm -rf /var/lib/apt/lists/*
