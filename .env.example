# Sao chép file này thành .env rồi điền giá trị thật. Không commit file .env.

# --- PostgreSQL (dùng bởi docker-compose và scripts/load_data.py) ---
POSTGRES_USER=vessel_app
POSTGRES_PASSWORD=change_me
POSTGRES_DB=vessels
POSTGRES_PORT=5433

# Chuỗi kết nối đầy đủ dùng bởi ứng dụng Python (phải khớp 4 biến ở trên
# khi chạy qua docker-compose với port mở ra host).
DATABASE_URL=postgresql://vessel_app:change_me@localhost:5433/vessels

# Thư mục chứa 4 file CSV nguồn. Mặc định là ./data nếu không set.
DATA_DIR=./data

# --- Ứng dụng chung ---
# Mức log: DEBUG | INFO | WARNING | ERROR. Mặc định INFO nếu không set.
LOG_LEVEL=INFO
