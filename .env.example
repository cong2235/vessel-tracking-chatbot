# Sao chép file này thành .env rồi điền giá trị thật. Không commit file .env.

# --- PostgreSQL (dùng bởi docker-compose và scripts/load_data.py) ---
POSTGRES_USER=vessel_app
POSTGRES_PASSWORD=change_me
POSTGRES_DB=vessels
POSTGRES_PORT=5433

# Chuỗi kết nối đầy đủ dùng bởi ứng dụng Python (phải khớp 4 biến ở trên
# khi chạy qua docker-compose với port mở ra host).
DATABASE_URL=postgresql://vessel_app:change_me@localhost:5433/vessels

# Thư mục chứa 4 file CSV nguồn. Mặc định là ./data nếu không set.
DATA_DIR=./data

# --- Ứng dụng chung ---
# Mức log: DEBUG | INFO | WARNING | ERROR. Mặc định INFO nếu không set.
LOG_LEVEL=INFO

# --- LLM (bất kỳ API nào tương thích chuẩn OpenAI Chat Completions) ---
OPENAI_API_KEY=sk-...
# Model mặc định gpt-4o-mini nếu không set. Đã verify thật (docs/research.md
# mục 1): tool-calling ổn định qua nhiều lần lặp, chi phí không đáng kể ở
# quy mô bài test, nhưng suy luận đa bước/bám instruction yếu hơn model
# full-size — cân nhắc gpt-4.1/gpt-4o nếu ưu tiên độ chính xác hơn giá.
OPENAI_CHAT_MODEL=gpt-4o-mini
# Tuỳ chọn: trỏ tới 1 API OpenAI-compatible khác (self-host qua vLLM,
# Cloudflare Workers AI...) thay vì endpoint OpenAI chính thức.
#
# QUAN TRỌNG: XOÁ HẲN dòng này (cả tên biến) khi dùng OpenAI thật — để lại
# "OPENAI_BASE_URL=" (rỗng nhưng VẪN TỒN TẠI trong môi trường) khiến chính
# OpenAI SDK tự đọc thẳng biến này và dùng chuỗi rỗng làm base_url thật,
# gây lỗi "missing http(s):// protocol" — phát hiện thật khi đổi provider.
# (Đã thêm lớp phòng vệ ở src/models/llm_client.py::get_client tự xoá biến
# rỗng này, nhưng an toàn nhất vẫn là không để dòng này tồn tại ở dạng rỗng.)
#
# Ví dụ khác đã verify thật — Cloudflare Workers AI (rẻ hơn nữa, nhưng phụ
# thuộc hạn ngạch miễn phí 10.000 neurons/ngày — đã từng hết hạn ngạch giữa
# lúc test thật, xem docs/research.md mục 1.3):
#   OPENAI_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/v1
#   OPENAI_CHAT_MODEL=@cf/openai/gpt-oss-20b
#   OPENAI_API_KEY=<Cloudflare API Token, quyền Account > Workers AI > Edit>
#
# Model dùng để tạo embedding cho bộ nhớ dài hạn (R3). Mặc định
# text-embedding-3-small (OpenAI thật).
EMBEDDING_MODEL=text-embedding-3-small
# Tuỳ chọn: ép số chiều output nhỏ hơn mặc định của model (OpenAI
# text-embedding-3-* hỗ trợ tham số `dimensions`, kỹ thuật Matryoshka,
# không cần đổi model/không mất nhiều chất lượng). Đặt 1024 để khớp đúng
# cột `vector(1024)` có sẵn trong db/schema.sql (thiết kế ban đầu cho
# bge-m3, vốn tự nhiên 1024 chiều) mà KHÔNG cần migrate DB khi đổi sang
# OpenAI (mặc định model là 1536 chiều nếu không giới hạn). Bỏ trống nếu
# dùng provider không hỗ trợ tham số này (vd. Cloudflare bge-m3) — khi đó
# SỐ CHIỀU phải tự khớp cột vector(1024) từ phía chọn đúng model.
EMBEDDING_DIMENSIONS=1024
# Số token tối đa model được sinh ra mỗi lượt gọi. gpt-oss dùng
# chain-of-thought riêng (Harmony) tốn token trước khi ra content cuối —
# 1024 KHÔNG ĐỦ cho câu hỏi cần nhiều bước (vd. N3 nhiều tàu), phát hiện
# thật qua test (finish_reason="length", content rỗng dù model "đã trả lời
# xong" trong phần suy luận). Mặc định 4096 nếu không set.
LLM_MAX_TOKENS=4096
# Timeout (giây) cho mỗi lời gọi HTTP tới LLM. Mặc định SDK là 600s (quá
# dài, có thể "treo" agent lâu không báo lỗi nếu mạng có vấn đề — phát
# hiện thật khi test). Mặc định 60 nếu không set.
LLM_TIMEOUT_SECONDS=60

# --- API server ---
APP_HOST=0.0.0.0
APP_PORT=8000

# --- Bộ nhớ hội thoại (R3) ---
# Số message (KHÔNG phải số "lượt hỏi-đáp") giữ nguyên văn trong cửa sổ
# ngắn hạn trước khi các lượt cũ hơn bị tóm tắt + nhúng vào pgvector. Đặt
# nhỏ (vd. 4-6) khi test để dễ ép trigger tóm tắt sớm.
CONTEXT_WINDOW_TURNS=10

# Rerank — tăng độ chính xác truy xuất bộ nhớ khi hội thoại dài có nhiều
# bản tóm tắt cạnh tranh nhau (embedding similarity một mình không đủ phân
# biệt, xem docs/architecture.md mục 7). true = thành phần này BẮT BUỘC
# nếu RERANKER_BASE_URL trỏ tới 1 provider có rerank thật (vd. Cloudflare
# bge-reranker-base); false = chỉ dùng embedding similarity.
#
# LƯU Ý: OpenAI KHÔNG có sản phẩm rerank (chỉ chat + embedding) — nếu
# OPENAI_BASE_URL ở trên để trống (dùng OpenAI thật), PHẢI đặt
# RERANKER_ENABLED=false trừ khi trỏ RERANKER_BASE_URL sang 1 provider
# khác (Cloudflare, Cohere Rerank...) tách biệt hoàn toàn khỏi LLM/embedding
# đang dùng. Cơ chế pin fact tường minh trong src/agent/memory.py (xem
# docs/research.md mục 6.3) đã giảm đáng kể mức độ cần thiết của rerank
# cho đúng use case kịch bản mẫu (câu "ghi nhớ giúp tôi...").
RERANKER_ENABLED=false
# Endpoint REST gốc của Cloudflare Workers AI (không phải /v1 OpenAI-compat
# — rerank không nằm trong chuẩn OpenAI API). Chỉ áp dụng khi
# RERANKER_ENABLED=true và bạn có tài khoản Cloudflare riêng cho việc này.
RERANKER_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/run
RERANKER_MODEL=@cf/baai/bge-reranker-base
