# Sao chép file này thành .env rồi điền giá trị thật. Không commit file .env.

# --- PostgreSQL (dùng bởi docker-compose và scripts/load_data.py) ---
POSTGRES_USER=vessel_app
POSTGRES_PASSWORD=change_me
POSTGRES_DB=vessels
POSTGRES_PORT=5433

# Chuỗi kết nối đầy đủ dùng bởi ứng dụng Python (phải khớp 4 biến ở trên
# khi chạy qua docker-compose với port mở ra host).
DATABASE_URL=postgresql://vessel_app:change_me@localhost:5433/vessels

# Thư mục chứa 4 file CSV nguồn. Mặc định là ./data nếu không set.
DATA_DIR=./data

# --- Ứng dụng chung ---
# Mức log: DEBUG | INFO | WARNING | ERROR. Mặc định INFO nếu không set.
LOG_LEVEL=INFO

# --- LLM (bất kỳ API nào tương thích chuẩn OpenAI Chat Completions) ---
OPENAI_API_KEY=sk-...
# Model mặc định gpt-4o-mini nếu không set.
OPENAI_CHAT_MODEL=gpt-4o-mini
# Tuỳ chọn: trỏ tới 1 API OpenAI-compatible khác thay vì endpoint OpenAI
# chính thức. Bỏ trống để dùng OpenAI mặc định.
OPENAI_BASE_URL=
# Số token tối đa model được sinh ra mỗi lượt gọi. gpt-oss dùng
# chain-of-thought riêng (Harmony) tốn token trước khi ra content cuối —
# 1024 KHÔNG ĐỦ cho câu hỏi cần nhiều bước, phát hiện thật qua test
# (finish_reason="length", content rỗng dù model "đã trả lời xong" trong
# phần suy luận). Mặc định 4096 nếu không set.
LLM_MAX_TOKENS=4096
# Timeout (giây) cho mỗi lời gọi HTTP tới LLM. Mặc định SDK là 600s (quá
# dài, có thể "treo" agent lâu không báo lỗi nếu mạng có vấn đề — phát
# hiện thật khi test). Mặc định 60 nếu không set.
LLM_TIMEOUT_SECONDS=60

# --- API server ---
APP_HOST=0.0.0.0
APP_PORT=8000
